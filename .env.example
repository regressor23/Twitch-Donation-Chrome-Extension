# TipVault — environment template.
# Copy to .env.local and fill in. Never commit real values (CLAUDE.md §4.8).
#
# The keys here are exactly the contract in CLAUDE.md §5.5, in the same order —
# tests/smoke.test.ts fails if the two drift apart. Add a variable in one place
# and you add it in all three.
#
# Everything except POLL_INTERVAL_MS is validated on boot by web/lib/env.ts:
# the server refuses to start and names the variable, rather than failing three
# layers down inside a driver.

# Solana RPC. PRIVATE is the one the server pays for and rate-limits are billed
# against, so it never reaches the browser; NEXT_PUBLIC_ is the throttled one
# Next inlines into the client bundle.
RPC_URL_PRIVATE=
NEXT_PUBLIC_RPC_URL=

# Postgres connection string. Since S3 this is Railway's managed instance, not
# Supabase. Holds every tip, so a leak is a leak of donor nicks and messages.
DATABASE_URL=

# Helius. HELIUS_API_KEY is only used by scripts/helius-webhook.ts to register
# the webhook. HELIUS_WEBHOOK_SECRET is the value Helius echoes back in the
# Authorization header — it is the only authentication their webhooks offer,
# which is why nothing in the body is trusted. See docs/security.md §3.
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=

# Guards POST /api/internal/poll, which forces an on-demand RPC sweep and is
# otherwise a free way to run up our RPC bill. Must differ from
# HELIUS_WEBHOOK_SECRET. See docs/security.md §3.
INTERNAL_TASK_SECRET=

# Signs the dashboard session cookie, the OAuth state and the wallet-ownership
# challenge — three things that are only trustworthy because nothing outside
# this process can forge them. Rotating it signs every streamer out.
SESSION_SECRET=

# USDC mint for the target cluster — devnet and mainnet differ, and the mint is
# what decides whether a transfer is a tip or a scam token asking for a moment
# on a streamer's screen.
USDC_MINT=

# Fallback sweep period in milliseconds (CLAUDE.md §10). Optional: the default
# lives in web/instrumentation.ts, so an incomplete .env cannot switch the
# fallback off. Only an explicit 0 disables the timer.
POLL_INTERVAL_MS=

# Signs the attestation the streamer presents to `claim`. Server only, never
# bundled: whoever holds it can mint attestations and drain every escrow.
AUTHORITY_SECRET=

# Twitch OAuth application — how a streamer proves the channel is theirs.
# Register at https://dev.twitch.tv/console/apps; the redirect URI must match
# what is registered there byte for byte, including the scheme and any port.
# Locally that is http://localhost:3000/api/auth/twitch/callback.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=

# cabina.ai MCP — TTS voices and alert packs. Without it the product falls back
# to the packs in web/public/packs (CLAUDE.md §10).
CABINA_MCP_URL=
CABINA_MCP_TOKEN=

# Mercuryo on-ramp widget, the card-to-crypto path for a viewer with no wallet.
MERCURYO_WIDGET_ID=

# --- Not part of the §5.5 contract -------------------------------------------
# These are commented out on purpose: tests/smoke.test.ts compares the KEY=
# lines above against §5.5, so anything here must stay a comment.
#
# HELIUS_CAPTURE=1 — store the raw webhook body in the `events` table, so a real
#   Helius payload can be captured and replayed when investigating a missed or
#   duplicated tip. Off by default; it writes donor memo text to the database.
#
# TEST_CHANNEL_ID, TEST_STREAMER, TEST_SCAM_MINT — devnet fixtures written by
#   scripts/setup-devnet.ts itself, so there is nothing to fill in by hand.
# TEST_OVERLAY_TOKEN — default token for scripts/measure-latency.ts, so it does
#   not have to be pasted on every run. Read the current one with:
#   pnpm --filter @tipvault/web overlay:token -- --show
