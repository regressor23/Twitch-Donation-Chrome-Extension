# TipVault — environment template.
# Copy to .env.local and fill in. Never commit real values (CLAUDE.md §4.8).

# Solana RPC. PRIVATE stays server-side, NEXT_PUBLIC_ is exposed to the browser.
RPC_URL_PRIVATE=
NEXT_PUBLIC_RPC_URL=

# Helius: transaction webhooks + enhanced RPC.
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=

# USDC mint address for the target cluster (devnet vs mainnet differ).
USDC_MINT=

# Attestation signing key for the claim flow. Server only, never bundled.
AUTHORITY_SECRET=

# Twitch OAuth application.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Supabase project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE=

# cabina.ai MCP (TTS / alert packs).
CABINA_MCP_URL=
CABINA_MCP_TOKEN=

# Mercuryo on-ramp widget.
MERCURYO_WIDGET_ID=
